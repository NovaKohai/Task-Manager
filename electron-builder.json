{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
   "appId": "com.novataskmanager.app",
  "productName": "Nova Task Manager",
  "icon": "build/icon.ico",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "win": {
    "target": ["nsis"],
    "icon": "build/icon.ico",
    "artifactName": "Nova-Task-Manager-Setup-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": true,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico",
    "include": "build/nsis-cleanup.nsh"
  },
  "publish": {
    "provider": "github",
    "owner": "NovaKohai",
    "repo": "Task-Manager",
    "private": true
  }
}
